#!/usr/bin/env bash
# social-block — block the sites that eat your time, during the hours you
# choose, by null-routing them in /etc/hosts.
#
# One file on purpose: you are about to run it as root, so you can read all
# of it first. https://github.com/anmol-goyal7/social-block

VERSION=0.1.0

# Everything the tool touches can be redirected. That is how the tests run
# without root and without ever seeing the real /etc/hosts.
HOSTS=${SOCIAL_BLOCK_HOSTS:-/etc/hosts}
CONFIG=${SOCIAL_BLOCK_CONFIG:-/etc/social-block/config}
STATE=${SOCIAL_BLOCK_STATE:-/var/lib/social-block}
NOW_OVERRIDE=${SOCIAL_BLOCK_NOW:-}

BEGIN='# BEGIN social-block'
END='# END social-block'

# Day names and sort order must not depend on the caller's locale.
export LC_ALL=C

# ---------------------------------------------------------------- helpers --

die()  { echo "social-block: $*" >&2; exit 1; }
warn() { echo "social-block: $*" >&2; }
trim() { local s=$1; s=${s#"${s%%[![:space:]]*}"}; s=${s%"${s##*[![:space:]]}"}; printf '%s' "$s"; }

usage() {
  cat <<'USAGE'
usage: social-block <command>

  status          what is blocked right now, why, and when that changes
  on              block now, until the next scheduled change
  off             unblock now, until the next scheduled change
  check [FILE]    validate a config file (default: the installed one)
  doctor          find out why the block is not working
  apply           reconcile /etc/hosts with the schedule once
  daemon          what the systemd service runs; not for humans
  version         print the version

Config: /etc/social-block/config   (see: social-block check)
USAGE
}

# ----------------------------------------------------------------- config --
# parse_config FILE fills these. A window record is "START|END|MASK|LABEL":
# minutes since midnight, a day bitmask (bit 0 = Monday … bit 6 = Sunday),
# and the canonical text shown to the user. The file is read line by line
# and never sourced — it is root-owned, and sourcing would turn a typo into
# code running as root.
WINDOWS=()
SITES=()
LOCK=false
CONFIG_ERRORS=()

DAY_NAMES=(mon tue wed thu fri sat sun)
HOST_RE='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'

CFG_NAME=''
CFG_LINE=0
cfg_err() { CONFIG_ERRORS+=("$CFG_NAME:$CFG_LINE: $*"); }

# "H:MM" -> minutes since midnight; fails on anything else.
parse_time() {
  [[ $1 =~ ^([0-9]{1,2}):([0-9]{2})$ ]] || return 1
  local h=$((10#${BASH_REMATCH[1]})) m=$((10#${BASH_REMATCH[2]}))
  (( h <= 23 && m <= 59 )) || return 1
  echo $((h * 60 + m))
}
fmt_time() { printf '%02d:%02d' $(($1 / 60)) $(($1 % 60)); }

day_index() {
  local i
  for i in 0 1 2 3 4 5 6; do
    if [[ ${DAY_NAMES[i]} == "$1" ]]; then echo "$i"; return 0; fi
  done
  return 1
}

# "mon-fri,sun" -> bitmask; ranges may wrap (fri-mon). Fails on any bad token.
parse_days() {
  local spec=${1,,} mask=0 tok a b i toks
  IFS=, read -ra toks <<< "$spec"
  [[ ${#toks[@]} -gt 0 ]] || return 1
  for tok in "${toks[@]}"; do
    tok=$(trim "$tok")
    case $tok in
      daily)    mask=127 ;;
      weekdays) mask=$(( mask | 31 )) ;;
      weekends) mask=$(( mask | 96 )) ;;
      ?*-?*)
        a=$(day_index "${tok%%-*}") || return 1
        b=$(day_index "${tok##*-}") || return 1
        i=$a
        while :; do
          mask=$(( mask | (1 << i) ))
          (( i == b )) && break
          i=$(( (i + 1) % 7 ))
        done ;;
      *)
        a=$(day_index "$tok") || return 1
        mask=$(( mask | (1 << a) )) ;;
    esac
  done
  (( mask > 0 )) || return 1
  echo "$mask"
}

fmt_days() {
  local mask=$1 i out=''
  case $mask in
    127) echo daily;    return 0 ;;
    31)  echo weekdays; return 0 ;;
    96)  echo weekends; return 0 ;;
  esac
  for i in 0 1 2 3 4 5 6; do
    (( mask & (1 << i) )) && out+="${out:+,}${DAY_NAMES[i]}"
  done
  echo "$out"
}

parse_schedule_line() {
  local line=$1 range days start end mask
  range=${line%%[[:space:]]*}
  days=$(trim "${line#"$range"}")
  [[ -n $days ]] || days=daily
  if [[ $range != *-* ]]; then cfg_err "expected \"H:MM-H:MM [days]\", got \"$line\""; return 0; fi
  start=$(parse_time "${range%%-*}") || { cfg_err "bad time \"${range%%-*}\""; return 0; }
  end=$(parse_time "${range#*-}")    || { cfg_err "bad time \"${range#*-}\""; return 0; }
  if (( start == end )); then cfg_err "window \"$range\" starts and ends at the same time"; return 0; fi
  mask=$(parse_days "$days") || { cfg_err "bad days \"$days\" (use mon-fri, sat,sun, daily, weekdays or weekends)"; return 0; }
  WINDOWS+=("$start|$end|$mask|$(fmt_time "$start")-$(fmt_time "$end") $(fmt_days "$mask")")
}

parse_option_line() {
  local line=$1 key val
  if [[ $line != *=* ]]; then cfg_err "expected \"key = value\", got \"$line\""; return 0; fi
  key=$(trim "${line%%=*}"); val=$(trim "${line#*=}"); val=${val,,}
  case $key in
    lock)
      case $val in
        true|false) LOCK=$val ;;
        *) cfg_err "lock must be true or false, got \"$val\"" ;;
      esac ;;
    *) cfg_err "unknown option \"$key\" (the only option is lock)" ;;
  esac
}

parse_site_line() {
  local host=${1,,}
  if [[ $host =~ $HOST_RE ]]; then SITES+=("$host"); else cfg_err "not a hostname: \"$1\""; fi
}

# Parses FILE into WINDOWS/SITES/LOCK. Reports every error, then returns 1.
parse_config() {
  local file=$1 section='' raw line
  WINDOWS=() SITES=() LOCK=false CONFIG_ERRORS=()
  CFG_NAME=${file##*/} CFG_LINE=0
  [[ -r $file ]] || { CONFIG_ERRORS+=("$file: cannot read"); return 1; }
  while IFS= read -r raw || [[ -n $raw ]]; do
    CFG_LINE=$((CFG_LINE + 1))
    line=$(trim "${raw%%#*}")
    [[ -n $line ]] || continue
    if [[ $line =~ ^\[(.*)\]$ ]]; then
      section=${BASH_REMATCH[1]}
      case $section in
        schedule|options|sites) ;;
        *) cfg_err "unknown section [$section]"; section=bad ;;
      esac
      continue
    fi
    case $section in
      schedule) parse_schedule_line "$line" ;;
      options)  parse_option_line "$line" ;;
      sites)    parse_site_line "$line" ;;
      bad)      ;;
      '')       cfg_err "\"$line\" is outside any section (expected [schedule], [options] or [sites] first)" ;;
    esac
  done < "$file"
  [[ ${#CONFIG_ERRORS[@]} -eq 0 ]]
}

# ------------------------------------------------------------------- time --
# Everything is local wall-clock at minute resolution. SOCIAL_BLOCK_NOW
# freezes "now" for tests and for asking "what would happen at 3am".

now_epoch() {
  if [[ -n $NOW_OVERRIDE ]]; then
    date -d "$NOW_OVERRIDE" +%s 2>/dev/null || die "SOCIAL_BLOCK_NOW: cannot parse \"$NOW_OVERRIDE\""
  else
    date +%s
  fi
}
fmt_epoch() { date -d "@$1" '+%a %H:%M'; }
fmt_delta() {
  local s=$1 d h m
  d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 ))
  if (( d > 0 )); then echo "${d}d ${h}h ${m}m"
  elif (( h > 0 )); then echo "${h}h ${m}m"
  else echo "${m}m"; fi
}

# Is any window active at EPOCH? Sets ACTIVE_LABEL to the one that is.
# A window that crosses midnight is judged by the day it started on.
ACTIVE_LABEL=''
schedule_active() {
  local epoch=$1 dow m yday w start end mask label
  read -r dow m <<< "$(date -d "@$epoch" '+%u %H%M')"
  dow=$(( dow - 1 ))                       # %u is 1=Mon..7=Sun; we use 0..6
  m=$(( 10#${m:0:2} * 60 + 10#${m:2:2} ))
  yday=$(( (dow + 6) % 7 ))
  ACTIVE_LABEL=''
  for w in "${WINDOWS[@]}"; do
    IFS='|' read -r start end mask label <<< "$w"
    if (( start < end )); then
      if (( mask & (1 << dow) )) && (( m >= start && m < end )); then ACTIVE_LABEL=$label; return 0; fi
    else
      if (( mask & (1 << dow) )) && (( m >= start )); then ACTIVE_LABEL=$label; return 0; fi
      if (( mask & (1 << yday) )) && (( m < end )); then ACTIVE_LABEL=$label; return 0; fi
    fi
  done
  return 1
}

# Prints the epoch of the next moment "schedule active" flips, or returns 1
# if it never does. The aggregate state can only change at some window's
# start or end, so those instants over the next 8 days are the only
# candidates; date -d builds them from "YYYY-MM-DD HH:MM" so DST is its job.
next_boundary() {
  local now=$1 cur cand noon day next d w start end mask label t cands=()
  if schedule_active "$now"; then cur=1; else cur=0; fi
  # Walk the calendar from today's noon in 24h steps: noon never lands near
  # a DST switch, and it avoids "+1 day", which date happily reads as a
  # UTC+1 offset when a time precedes it.
  noon=$(date -d "$(date -d "@$now" +%F) 12:00" +%s)
  for d in 0 1 2 3 4 5 6 7; do
    day=$(date -d "@$(( noon + d * 86400 ))" +%F)
    next=$(date -d "@$(( noon + (d + 1) * 86400 ))" +%F)
    for w in "${WINDOWS[@]}"; do
      IFS='|' read -r start end mask label <<< "$w"
      t=$(date -d "$day $(fmt_time "$start")" +%s)
      (( t > now )) && cands+=("$t")
      if (( start < end )); then t=$(date -d "$day $(fmt_time "$end")" +%s)
      else t=$(date -d "$next $(fmt_time "$end")" +%s); fi
      (( t > now )) && cands+=("$t")
    done
  done
  [[ ${#cands[@]} -gt 0 ]] || return 1
  while read -r cand; do
    if schedule_active "$cand"; then t=1; else t=0; fi
    if (( t != cur )); then echo "$cand"; return 0; fi
  done < <(printf '%s\n' "${cands[@]}" | sort -n -u)
  return 1
}

# ------------------------------------------------------------------ hosts --
# We own exactly the lines between the sentinels and nothing else. Both an
# IPv4 and an IPv6 line per host: a resolver that asks per address family
# ("hosts: files dns") would otherwise answer AAAA from DNS and leak.

render_region() {
  local s
  echo "$BEGIN"
  for s in "${SITES[@]}"; do
    echo "0.0.0.0 $s www.$s m.$s"
    echo ":: $s www.$s m.$s"
  done
  echo "$END"
}

# The current file with every copy of our region removed — including a
# BEGIN that never found its END, which swallows to end of file rather than
# leave half a region behind.
strip_region() {
  awk -v b="$BEGIN" -v e="$END" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip   { print }' "$HOSTS"
}

region_present() { grep -qxF "$BEGIN" "$HOSTS"; }

flush_resolver() {
  # systemd-resolved caches answers and may keep serving the pre-switch one.
  [[ $HOSTS == /etc/hosts ]] || return 0
  command -v resolvectl >/dev/null 2>&1 || return 0
  timeout 5 resolvectl flush-caches >/dev/null 2>&1 || true
}

# write_hosts on|off: converge the file. Returns 0 if it changed anything,
# 1 if the file already matched (then nothing is written or flushed).
write_hosts() {
  local state=$1 tmp
  tmp=$(mktemp "$HOSTS.XXXXXX")       # same directory, so the mv is atomic
  { strip_region; if [[ $state == on ]]; then render_region; fi; } > "$tmp"
  if cmp -s "$tmp" "$HOSTS"; then rm -f "$tmp"; return 1; fi
  # mktemp made it 0600; that would break name resolution for every
  # non-root process on the machine. Copy the original's mode and owner.
  chmod --reference="$HOSTS" "$tmp"
  chown --reference="$HOSTS" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$HOSTS"
  flush_resolver
  return 0
}

# --------------------------------------------------------------- override --
# "on"/"off" by hand are temporary: the override carries the next boundary
# as its expiry, so the schedule always takes over again by itself.

OV_STATE=''
OV_UNTIL=''

# Loads the override if it is valid and unexpired; otherwise drops it.
read_override() {
  local now=$1 f=$STATE/override k v
  OV_STATE='' OV_UNTIL=''
  [[ -f $f ]] || return 1
  while IFS== read -r k v; do
    case $k in state) OV_STATE=$v ;; until) OV_UNTIL=$v ;; esac
  done < "$f"
  if [[ ($OV_STATE != on && $OV_STATE != off) || ! $OV_UNTIL =~ ^[0-9]+$ ]] || (( now >= OV_UNTIL )); then
    rm -f "$f" 2>/dev/null || true
    OV_STATE='' OV_UNTIL=''
    return 1
  fi
  return 0
}

write_override() {
  mkdir -p "$STATE"
  printf 'state=%s\nuntil=%s\n' "$1" "$2" > "$STATE/override"
}

# -------------------------------------------------------------- reconcile --

CONFIG_OK=0
DESIRED=off
REASON=''

lock_word() { if [[ $LOCK == true ]]; then echo on; else echo off; fi; }

# What /etc/hosts should say at NOW. An override beats the schedule; an
# invalid config means "off" (fail open — a typo must never lock anyone out).
compute_desired() {
  local now=$1
  if read_override "$now"; then
    DESIRED=$OV_STATE REASON="override until $(fmt_epoch "$OV_UNTIL")"
  elif (( CONFIG_OK )) && schedule_active "$now"; then
    DESIRED=on REASON=$ACTIVE_LABEL
  elif (( CONFIG_OK )); then
    DESIRED=off REASON='no window active'
  else
    DESIRED=off REASON='config invalid'
  fi
}

# Report config errors. The daemon calls this every minute, so in quiet
# mode an error is printed once when it appears, not once per tick.
report_config_errors() {
  local mode=$1 err
  err=$(printf '%s\n' "${CONFIG_ERRORS[@]}")
  if [[ $mode == verbose || $err != "$(cat "$STATE/last-error" 2>/dev/null || true)" ]]; then
    printf '%s\n' "${CONFIG_ERRORS[@]}" >&2
    warn "config invalid — block is off until it is fixed ($CONFIG)"
  fi
  mkdir -p "$STATE"
  printf '%s\n' "$err" > "$STATE/last-error"
}

# One pass: read config, decide, converge, say so only if something changed.
reconcile() {
  local mode=$1 now
  now=$(now_epoch)
  if parse_config "$CONFIG"; then
    CONFIG_OK=1
    rm -f "$STATE/last-error" 2>/dev/null || true
  else
    CONFIG_OK=0
    report_config_errors "$mode"
  fi
  compute_desired "$now"
  if write_hosts "$DESIRED"; then warn "$DESIRED ($REASON)"; fi
  (( CONFIG_OK )) || return 4
  return 0
}

# Root is about the files, not the user: whoever can write the hosts file
# and the state directory may run the writing commands.
need_root() {
  local dir=${HOSTS%/*} parent=${STATE%/*}
  if [[ ! -w $HOSTS || ! -w ${dir:-/} ]] \
     || { [[ -e $STATE ]] && [[ ! -w $STATE ]]; } \
     || { [[ ! -e $STATE ]] && [[ ! -w ${parent:-/} ]]; }; then
    die "needs root — try: sudo social-block $1"
  fi
}

cmd_apply() { need_root apply; reconcile verbose; }

# --------------------------------------------------------------- commands --

# Force a state until the next boundary (or 24 h if the schedule has none).
set_override() {
  local want=$1 now until=''
  now=$(now_epoch)
  if parse_config "$CONFIG"; then
    if [[ $want == off && $LOCK == true ]] && schedule_active "$now"; then
      until=$(next_boundary "$now" || true)
      echo "social-block: locked — $ACTIVE_LABEL is active${until:+ until $(fmt_epoch "$until")} (lock = true in $CONFIG)" >&2
      exit 3
    fi
    until=$(next_boundary "$now" || true)
  else
    printf '%s\n' "${CONFIG_ERRORS[@]}" >&2
  fi
  [[ -n $until ]] || until=$(( now + 86400 ))
  write_override "$want" "$until"
  reconcile quiet >/dev/null 2>&1 || true
  echo "social-block: $want until $(fmt_epoch "$until")"
}
cmd_on()  { need_root on;  set_override on; }
cmd_off() { need_root off; set_override off; }

cmd_status() {
  local now rc=0 w nb have
  now=$(now_epoch)
  if parse_config "$CONFIG"; then CONFIG_OK=1; else CONFIG_OK=0; rc=4; printf '%s\n' "${CONFIG_ERRORS[@]}" >&2; fi
  compute_desired "$now"
  echo "social-block: ${DESIRED^^} ($REASON)"
  if (( CONFIG_OK )); then
    echo "schedule: ${#WINDOWS[@]} window(s), ${#SITES[@]} site(s), lock $(lock_word)"
    for w in "${WINDOWS[@]}"; do echo "  ${w##*|}"; done
    if nb=$(next_boundary "$now"); then
      echo "next change: $(fmt_epoch "$nb") (in $(fmt_delta $(( nb - now ))))"
    else
      echo "next change: never (the schedule is empty or covers every hour)"
    fi
  else
    echo "config: INVALID — block is off until it is fixed ($CONFIG)"
  fi
  [[ -z $OV_STATE ]] || echo "override: $OV_STATE until $(fmt_epoch "$OV_UNTIL")"
  if region_present; then have=on; else have=off; fi
  [[ $have == "$DESIRED" ]] || echo "hosts: $have — out of sync; the service fixes this within a minute (or: sudo social-block apply)"
  return "$rc"
}

cmd_check() {
  local file=${1:-$CONFIG} w
  if parse_config "$file"; then
    echo "$file: ok — ${#WINDOWS[@]} window(s), ${#SITES[@]} site(s), lock $(lock_word)"
    for w in "${WINDOWS[@]}"; do echo "  ${w##*|}"; done
    (( ${#WINDOWS[@]} )) || echo "  (no windows — nothing will ever be blocked)"
    (( ${#SITES[@]} ))   || echo "  (no sites — nothing will ever be blocked)"
  else
    printf '%s\n' "${CONFIG_ERRORS[@]}" >&2
    return 4
  fi
}

# ------------------------------------------------------------------- main --

main() {
  set -euo pipefail
  local cmd=${1:-}
  [[ $# -gt 0 ]] && shift
  case $cmd in
    status)           cmd_status ;;
    on)               cmd_on ;;
    off)              cmd_off ;;
    check)            cmd_check "$@" ;;
    apply)            cmd_apply ;;
    version)          echo "social-block $VERSION" ;;
    help|-h|--help)   usage ;;
    '')               usage >&2; exit 2 ;;
    *)                echo "social-block: unknown command \"$cmd\"" >&2; usage >&2; exit 2 ;;
  esac
}

[[ ${BASH_SOURCE[0]} != "$0" ]] || main "$@"
